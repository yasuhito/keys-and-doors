      "id": "stage-104",
      "kind": "prove",
      "logic": "classical",
      "induction": true,
      "tasks": [
        {
          "goal": "∀x.∃y.(x ≤ y ∧ ¬(y = x))",
          "assumptions": [
            "∀x.(x + 0 = x)",
            "∀x.∀y.(x + s(y) = s(x + y))",
            "∀x.¬(s(x) = 0)",
            "∀x.∀y.(s(x) = s(y) → x = y)"
          ]
        }
      ],
      "lemmas": [
        "∀x.(x ≤ s(x))"
      ],
      "definitions": [
        "additive-order"
      ]
    }
